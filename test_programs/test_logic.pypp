// Operator negacji (!)
var a = !0;
print(a); // spodziewane: 1

var b = !1;
print(b); // spodziewane: 0

var c = !0.0;
print(c); // spodziewane: 1

var d = !3.14;
print(d); // spodziewane: 0

// Operator && z typami mieszanymi
var e = 1 && 2.5;
print(e); // spodziewane: 1

var f = 0 && 5.0;
print(f); // spodziewane: 0

var g = 3.3 && 0;
print(g); // spodziewane: 0

// Operator || z typami mieszanymi
var h = 0 || 2.5;
print(h); // spodziewane: 1

var i = 0.0 || 0;
print(i); // spodziewane: 0

var j = 1.0 || 0;
print(j); // spodziewane: 1

// Operator XOR (#)
var k = 1 # 0.0;
print(k); // spodziewane: 1

var l = 0.0 # 0;
print(l); // spodziewane: 0

var m = 1.0 # 1;
print(m); // spodziewane: 0

// Kombinacje logiczne z nawiasami
var n = !(0.0 || 0);
print(n); // spodziewane: 1

var o = !(1.0 && 1);
print(o); // spodziewane: 0

var p = !(3.5 # 0);
print(p); // spodziewane: 0
