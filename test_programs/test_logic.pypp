var a = 3;
var b = 5;
var c = 8;

// 3 + 2 == 5 → true (1)
var res1 = (a + 2) == b;
print(res1); // 1

// 3 * 2 < 8 → true (1)
var res2 = (a * 2) < c;
print(res2); // 1

// (3 * 3 == 9) && (5 < 8) → true && true → true (1)
var res3 = (a * a == 9) && (b < c);
print(res3); // 1

// (3 + 5 > 10) || (8 - 3 == 5) → false || true → true (1)
var res4 = (a + b > 10) || (c - a == 5);
print(res4); // 1

// !(5 == 5) → false → 0
var res5 = !(b == 5);
print(res5); // 0

// !(3 != 3) → !(false) → true → 1
var res6 = !(a != 3);
print(res6); // 1

// !(3 + 2 < 5) → !(false) → 1
var res7 = !((a + 2) < 5);
print(res7); // 1

// 3 == 3 && !(8 < 5) → true && true → 1
var res8 = (a == 3) && !(c < b);
print(res8); // 1

// ((3 + 2) == 5) && ((5 + 3) != 9) → true && true → 1
var res9 = ((a + 2) == 5) && ((b + a) != 9);
print(res9); // 1

// ((3 ^ 2) == 9) || (5 * 2 > 10) → true || false → 1
var res10 = ((a ^ 2) == 9) || ((b * 2) > 10);
print(res10); // 1
