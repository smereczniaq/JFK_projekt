// Test logicznego OR (||) z typami int i double

// int || int
var a = 0 || 1;
print(a); // spodziewane: 1

// double || double
var b = 0.0 || 2.2;
print(b); // spodziewane: 1

// double || zero
var c = 3.14 || 0.0;
print(c); // spodziewane: 1

// zero || double
var d = 0.0 || 0.0;
print(d); // spodziewane: 0

// int || double
var e = 0 || 4.5;
print(e); // spodziewane: 1

// double || int
var f = 1.0 || 0;
print(f); // spodziewane: 1

// zagnieżdżone OR z mixem typów
var g = 0 || 0.0 || 0 || 5.5;
print(g); // spodziewane: 1

// wszystkie falsy
var h = 0 || 0.0 || 0;
print(h); // spodziewane: 0
