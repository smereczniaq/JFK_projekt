// Testy logicznego AND (&&) — zwraca 1, jeśli oba operandy są prawdziwe (≠ 0)

var t = 1;
var f = 0;

// 1 && 1 => 1
var res1 = t && t;
print(res1); // oczekiwane: 1

// 1 && 0 => 0
var res2 = t && f;
print(res2); // oczekiwane: 0

// 0 && 1 => 0
var res3 = f && t;
print(res3); // oczekiwane: 0

// 0 && 0 => 0
var res4 = f && f;
print(res4); // oczekiwane: 0

// 1 && 1 && 1 => 1
var res5 = t && t && t;
print(res5); // oczekiwane: 1

// 1 && 1 && 0 => 0
var res6 = t && t && f;
print(res6); // oczekiwane: 0

// 0 && 1 && 1 => 0
var res7 = f && t && t;
print(res7); // oczekiwane: 0

// zagnieżdżone z wyrażeniem
var res8 = (1 + 1) && (3 - 3);
print(res8); // oczekiwane: 0
