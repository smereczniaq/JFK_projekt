// Test logicznego AND (&&) z typami int i double

// int && int
var a = 1 && 1;
print(a); // spodziewane: 1

// double && double
var b = 2.5 && 3.5;
print(b); // spodziewane: 1

// int && double
var c = 0 && 3.5;
print(c); // spodziewane: 0

// double && int
var d = 0.0 && 1;
print(d); // spodziewane: 0

// zero && zero
var e = 0.0 && 0;
print(e); // spodziewane: 0

// true && false
var f = 1.0 && 0.0;
print(f); // spodziewane: 0

// zagnieżdżone AND z mixem typów
var g = 1 && 2.0 && 3 && 4.4;
print(g); // spodziewane: 1
