// Test logicznego XOR (#) z typami int i double

// int # int
var a = 0 # 1;
print(a); // spodziewane: 1

var b = 1 # 1;
print(b); // spodziewane: 0

// double # double
var c = 0.0 # 3.14;
print(c); // spodziewane: 1

var d = 2.5 # 2.5;
print(d); // spodziewane: 0

// int # double
var e = 1 # 0.0;
print(e); // spodziewane: 1

var f = 0 # 0.0;
print(f); // spodziewane: 0

// double # int
var g = 3.0 # 0;
print(g); // spodziewane: 1

var h = 3.0 # 3;
print(h); // spodziewane: 0 (oba true)

// zagnieżdżone XOR
var i = 0 # 1.1 # 1;
print(i); // spodziewane: 0

var j = 0.0 # 0 # 1;
print(j); // spodziewane: 1
