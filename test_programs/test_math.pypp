// Podstawowe operacje arytmetyczne — int i double

// int + int
var a = 5 + 3;
print(a); // spodziewane: 8

// double + double
var b = 2.5 + 4.5;
print(b); // spodziewane: 7.0

// int + double
var c = 3 + 2.2;
print(c); // spodziewane: 5.2

// double + int
var d = 1.1 + 4;
print(d); // spodziewane: 5.1

// int - double
var e = 10 - 2.5;
print(e); // spodziewane: 7.5

// double - int
var f = 7.7 - 2;
print(f); // spodziewane: 5.7

// int * double
var g = 3 * 1.5;
print(g); // spodziewane: 4.5

// double * int
var h = 2.0 * 8;
print(h); // spodziewane: 16.0

// int / int
var i = 9 / 2;
print(i); // spodziewane: 4

// double / int
var j = 9.0 / 2;
print(j); // spodziewane: 4.5

// int / double
var k = 9 / 2.0;
print(k); // spodziewane: 4.5

// double / double
var l = 7.5 / 2.5;
print(l); // spodziewane: 3.0
