// Testy operatorów porównania

var a = 5;
var b = 10;

// Równość
var res1 = a == a;
print(res1); // oczekiwane: 1

var res2 = a == b;
print(res2); // oczekiwane: 0

// Nierówność
var res3 = a != b;
print(res3); // oczekiwane: 1

var res4 = a != a;
print(res4); // oczekiwane: 0

// Mniejsze
var res5 = a < b;
print(res5); // oczekiwane: 1

var res6 = b < a;
print(res6); // oczekiwane: 0

// Mniejsze lub równe
var res7 = a <= b;
print(res7); // oczekiwane: 1

var res8 = b <= b;
print(res8); // oczekiwane: 1

var res9 = b <= a;
print(res9); // oczekiwane: 0

// Większe
var res10 = b > a;
print(res10); // oczekiwane: 1

var res11 = a > b;
print(res11); // oczekiwane: 0

// Większe lub równe
var res12 = b >= a;
print(res12); // oczekiwane: 1

var res13 = a >= b;
print(res13); // oczekiwane: 0

var res14 = a >= a;
print(res14); // oczekiwane: 1
