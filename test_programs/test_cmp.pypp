// Porównania int vs int
var a = 5 == 5;
print(a); // spodziewane: 1

var b = 3 != 3;
print(b); // spodziewane: 0

var c = 2 < 5;
print(c); // spodziewane: 1

var d = 4 <= 4;
print(d); // spodziewane: 1

var e = 7 > 6;
print(e); // spodziewane: 1

var f = 9 >= 10;
print(f); // spodziewane: 0

// Porównania double vs double
var g = 3.14 == 3.14;
print(g); // spodziewane: 1

var h = 1.1 != 2.2;
print(h); // spodziewane: 1

var i = 2.5 < 5.0;
print(i); // spodziewane: 1

var j = 4.5 <= 4.4;
print(j); // spodziewane: 0

var k = 7.7 > 6.6;
print(k); // spodziewane: 1

var l = 9.0 >= 9.1;
print(l); // spodziewane: 0

// Porównania int vs double
var m = 5 == 5.0;
print(m); // spodziewane: 1

var n = 5 != 5.1;
print(n); // spodziewane: 1

var o = 4 < 4.5;
print(o); // spodziewane: 1

var p = 6 <= 5.9;
print(p); // spodziewane: 0

// Porównania double vs int
var q = 3.0 == 3;
print(q); // spodziewane: 1

var r = 2.1 > 2;
print(r); // spodziewane: 1

var s = 1.0 >= 2;
print(s); // spodziewane: 0
